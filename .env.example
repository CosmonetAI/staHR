# Copy to .env and fill with your Supabase project values

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_EDGE_IMPORT_URL=https://your-project-ref.functions.supabase.co
VITE_FUNCTIONS_BASE=https://your-project-ref.functions.supabase.co
VITE_EDGE_FUNCTIONS_URL=https://your-project-ref.functions.supabase.co
APP_URL=https://your-app-url

# Server-only value for OAuth signup invite emails.
# The server uses VITE_SUPABASE_URL for the project URL.
# Never expose the service role key in frontend VITE_* vars.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional dev shortcuts used by the app
# VITE_DEV_SKIP_AUTH=true
# VITE_ALLOW_DEV_LOGIN=true
# VITE_DEV_USER_EMAIL=dev@local
# VITE_DEV_USER_PASS=devpass
